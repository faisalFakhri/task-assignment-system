# Set this to the GitHub Pages base path for production builds.
# Example for a repo named "Task-Assigment": /Task-Assigment/
VITE_BASE_PATH=/

# Data source selection: 'mock' or 'api'
# Default mode if omitted is 'mock'
VITE_DATA_SOURCE=mock

# Google Apps Script Web App Deployment URL
# Leave empty for mock mode. Populate in local environments.
VITE_API_URL=
